{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": false,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": ".",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext",
		"esModuleInterop": true
	},
	"include": ["src"]
}
