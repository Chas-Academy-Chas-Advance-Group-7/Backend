{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noEmit": false,
		"emitDeclarationOnly": false,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext"
	},
	"include": ["src"]
}
